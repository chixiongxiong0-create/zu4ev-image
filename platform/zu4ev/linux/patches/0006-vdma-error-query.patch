 }
 EXPORT_SYMBOL_GPL(xilinx_vdma_channel_is_halted);
 
+/* Client-visible latched and current VDMA errors without mapping registers. */
+int xilinx_vdma_channel_has_error(struct dma_chan *dchan)
+{
+    struct xilinx_dma_chan *chan = to_xilinx_chan(dchan);
+
+    if (chan->xdev->dma_config->dmatype != XDMA_TYPE_VDMA)
+        return -EINVAL;
+    return READ_ONCE(chan->err) ||
+        !!(dma_ctrl_read(chan, XILINX_DMA_REG_DMASR) & XILINX_DMA_DMASR_ALL_ERR_MASK);
+}
+EXPORT_SYMBOL_GPL(xilinx_vdma_channel_has_error);
